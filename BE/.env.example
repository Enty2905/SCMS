# ==========================================
# SCMS - Supply Chain Management System
# Environment Variables
# Copy file này thành .env và điền giá trị thực
# ==========================================

# Server
SERVER_PORT=8081

# MySQL
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=scms_db

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://mysql_db:3306/scms_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_root_password_here

# phpMyAdmin
PMA_HOST=mysql_db

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Logging
LOG_LEVEL=INFO
LOG_PATH=/var/log/scms

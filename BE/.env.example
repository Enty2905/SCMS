# Server
SERVER_PORT=8081
SERVER_CONTEXT_PATH=/scms/api
APP_TIME_ZONE=Asia/Ho_Chi_Minh
MYSQL_SESSION_TIME_ZONE=+07:00

# Branding
APP_NAME=SCMS
APP_DESCRIPTION="Hệ thống quản lý vận hành và bảo trì"
APP_VERSION=1.0.0
APP_TEAM_NAME="SCMS Team"
APP_CONTACT_EMAIL=scms-team@example.com
COMPANY_NAME="Nhà máy Nhiệt điện"
COMPANY_OWNER="CÔNG TY SCMS"
COMPANY_REPAIR="CTY CP SCMS"
COMPANY_REQUEST="CÔNG TY SCMS"
WORK_ORDER_UNIT="SCMS MAINTENANCE"
EMPLOYEE_EMAIL_DOMAIN=nhm.vn

# MySQL and datasource
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=scms_db
MYSQL_HOST_PORT=3307
SPRING_DATASOURCE_URL=jdbc:mysql://mysql_db:3306/scms_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
JPA_SHOW_SQL=false

# JWT: use a random value with at least 64 characters
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long-before-running
JWT_VALID_DURATION=86400
JWT_REFRESHABLE_DURATION=604800

# CORS and API documentation
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*
SWAGGER_ENABLED=true

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_EMPLOYEE_FOLDER=scms/employees
CLOUDINARY_EQUIPMENT_FOLDER=scms/equipment
CLOUDINARY_WORK_ORDER_FOLDER=scms/work-orders
CLOUDINARY_ASSESSMENT_FOLDER=scms/assessments
CLOUDINARY_CONSUMABLE_REQUEST_FOLDER=scms/consumable-requests
CLOUDINARY_SPARE_PART_REQUEST_FOLDER=scms/spare-part-requests

# Uploads
PDF_UPLOAD_DIR=uploads/pdf
EMPLOYEE_AVATAR_DIR=uploads/employees
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=20MB

# Runtime and logging
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
LOG_PATH=/var/log/scms
PHPMYADMIN_PORT=8080
PMA_HOST=mysql_db
